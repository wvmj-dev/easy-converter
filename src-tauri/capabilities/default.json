{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window: app events, file dialogs, settings store and opener.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "store:default",
    "opener:allow-reveal-item-in-dir"
  ]
}
